# ==========================================
# IGNITEDDREAMS — PRODUCTION (docker compose) ENV
# Copy to .env next to docker-compose.yml and fill every value.
# ==========================================

# Public site URL (HTTPS). Nginx serves the site and routes /api to the backend.
FRONTEND_URL=https://www.igniteddreams.com

# DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # long random password
POSTGRES_DB=igniteddreams

# SECURITY (generate with: openssl rand -hex 32)
JWT_SECRET=
CLEANUP_SECRET=

# FIRST ADMIN + LEAD INSTRUCTOR (used by the seed script; passwords are generated if left blank)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_INSTRUCTOR_EMAIL=
SEED_INSTRUCTOR_PASSWORD=

# RAZORPAY (rzp_test_* keys for testing, rzp_live_* after KYC)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=      # set the same value in Razorpay Dashboard → Webhooks

# LIVEKIT CLOUD (live classes + recording)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# CLOUDFLARE R2 PRIVATE BUCKET (recordings + library files)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=igniteddreams-recordings
R2_ENDPOINT=

# EMAIL (receipts, password reset, enquiry alerts) — any SMTP provider
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ignited Dreams <admissions@igniteddreams.com>"
ADMIN_NOTIFY_EMAIL=           # inbox that receives new admission & enquiry alerts

# ACADEMY POLICIES
ACADEMY_NAME="Ignited Dreams Integrated"
ACADEMY_TIMEZONE="Asia/Kolkata"
RECORDING_RETENTION_DAYS=7    # student watch/download window
ARCHIVE_RETENTION_DAYS=730    # private vault after that (2 years), then auto-deleted
