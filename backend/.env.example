# ==========================================
# IGNITEDDREAMS BACKEND — LOCAL DEVELOPMENT
# Copy to backend/.env
# ==========================================

PORT=5000
NODE_ENV=development

# Local dev uses SQLite (npm run db:push:sqlite). Production uses PostgreSQL via DATABASE_URL.
SQLITE_DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/igniteddreams?schema=public"

# AUTHENTICATION (production: openssl rand -hex 32)
JWT_SECRET="change-me-local-dev-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="ignited_session"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# FIRST ADMIN + LEAD INSTRUCTOR for `npm run prisma:seed` (passwords generated if blank)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_INSTRUCTOR_EMAIL=""
SEED_INSTRUCTOR_PASSWORD=""

# RAZORPAY — test keys from Dashboard → Account & Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# LIVEKIT CLOUD — Project → Settings → Keys
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# CLOUDFLARE R2 PRIVATE STORAGE (keep the bucket private; never expose these to the frontend)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="igniteddreams-recordings"
R2_ENDPOINT=""

# EMAIL (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
ADMIN_NOTIFY_EMAIL=""

# ACADEMY POLICIES
ACADEMY_NAME="Ignited Dreams Integrated"
ACADEMY_TIMEZONE="Asia/Kolkata"
RECORDING_RETENTION_DAYS=7
ARCHIVE_RETENTION_DAYS=730
CLASS_JOIN_WINDOW_MINUTES=15

# INTERNAL CRON / CLEANUP SECRET
CLEANUP_SECRET="change-me-local-cleanup-secret"
